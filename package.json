{
  "name": "zombie-bagarre",
  "version": "4.42.0",
  "description": "Zombie Bagarre: Quarantine \u2014 2.5D survival action",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:campaign": "node scripts/campaign-check.mjs",
