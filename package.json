{
  "name": "zombie-bagarre",
  "version": "4.52.0",
  "description": "Zombie Bagarre: Quarantine \u2014 2.5D survival action",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=4 tests/*.test.js",
    "test:campaign": "node scripts/campaign-check.mjs",
    "desktop:dev": "npm run build && electron . --steam-deck --windowed",
    "desktop:linux": "npm run build && node scripts/build-desktop.mjs",
    "desktop:mac": "npm run build && node scripts/build-desktop.mjs --mac",
    "test:rook": "node scripts/art/test-rook.mjs",
    "predev": "node scripts/art/pack-rook-runtime.mjs",
    "prebuild": "node scripts/art/pack-rook-runtime.mjs",
    "pretest:rook": "node scripts/art/pack-rook-runtime.mjs",
    "android:build": "node scripts/build-android.mjs",
    "postbuild": "node scripts/verify-build-version.mjs"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "vite": "^5.4.11",
    "vite-plugin-glsl": "^1.3.0"
  },
  "main": "desktop/main.cjs"
}
