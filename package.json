  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "vite": "^5.4.11",
    "vite-plugin-glsl": "^1.3.0"
  },
  "main": "desktop/main.cjs"
}
